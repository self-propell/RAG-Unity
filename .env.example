# ═══════════════════════════════════════════════════
#  Unity RAG Agent 配置文件
#  复制为 .env 后填入你的实际值
# ═══════════════════════════════════════════════════

# ── LLM Provider ──────────────────────────────────
# 可选: claude / openai
LLM_PROVIDER=claude

# ── Claude (Anthropic) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx
CLAUDE_MODEL=claude-sonnet-4-6

# ── OpenAI / Codex ────────────────────────────────
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o
# 第三方兼容 API 地址（Azure、DeepSeek 等），留空使用 OpenAI 官方
OPENAI_BASE_URL=

# ── 多工程管理 ────────────────────────────────────
PROJECTS_DB_PATH=./projects.json
CHROMA_DB_ROOT=./rag_databases

# ── RAG 参数 ──────────────────────────────────────
RAG_TOP_K=6
CHUNK_MAX_TOKENS=600

# ── Unity 工程默认信息 ────────────────────────────
UNITY_VERSION=2022.3 LTS
RENDER_PIPELINE=URP

# ── Web Dashboard ─────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
